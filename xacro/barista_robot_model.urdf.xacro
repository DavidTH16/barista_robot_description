<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="barista_robot">

<!-- ____________________________ Materials defined for this robot____________-->
<material name="blue">
<color rgba="0.0 0.0 1.0 1"/>
</material>

<material name="gray">
<color rgba="0.5 0.5 0.5 1"/>
</material> 

<material name="rubber_black">
<color rgba="0.05 0.05 0.05 1"/>
</material>

<!-- include gazebo tags-->
<xacro:include filename="$(find barista_robot_description)/xacro/drive_wheel.xacro"/>
<xacro:include filename="$(find barista_robot_description)/xacro/caster_wheel.xacro"/>
<xacro:include filename="$(find barista_robot_description)/xacro/standoff_rod.xacro"/>
<xacro:include filename="$(find barista_robot_description)/xacro/cup_holder_tray.xacro"/>
<xacro:include filename="$(find barista_robot_description)/xacro/laser_scanner.xacro"/>

<!-- main properties for the robot-->
<xacro:property name="body_radius" value="0.178"/>
<xacro:property name="body_length" value="0.155"/>
<xacro:property name="wheel_length" value="0.0206"/>
<xacro:property name="wheel_radius" value="0.0352"/>
<xacro:property name="caster_radius" value="0.0242"/>
<xacro:property name="standoff_length" value="0.220"/>
<xacro:property name="standoff_radius" value="0.010"/>
<xacro:property name="cup_tray_radius" value="0.160"/>
<xacro:property name="cup_tray_length" value="0.090"/>
<xacro:arg name="include_laser" default="false"/>

<!-- ____________________________ Base link______________________________________ -->
<link name="base_link">
</link>

<link name="base_body">
<visual>
<geometry>
<cylinder length="${body_length}" radius="${body_radius}"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="${body_length}" radius="${body_radius}"/>
</geometry>
</collision>

<!-- mass 7kg-->
<inertial>
<mass value ="7.0"/>
<origin rpy="0 0 0" xyz="0 0 0"/>
<inertia ixx="0.06946" ixy="0.0" ixz="0.0" iyy="0.06946" iyz="0.0" izz="0.11089"/>
</inertial>
</link>

<joint name="base_link_joint" type="fixed">
<origin rpy="0 0 0" xyz="0 0 0.0995"/>
<parent link="base_link"/>
<child link="base_body"/>
</joint>

<!--___________________________Including wheels______________________________-->
<xacro:drive_wheel wheel_name_link="base_wheel_right" joint_name="joint_wheel_right" radius="${wheel_radius}" length="${wheel_length}" y_pos="${-0.150}"/>
<xacro:drive_wheel wheel_name_link="base_wheel_left" joint_name="joint_wheel_left" radius="${wheel_radius}" length="${wheel_length}" y_pos="${0.150}"/>

<!--___________________________Including castor wheels_______________________-->
<xacro:caster_wheel caster_link="front" radius="${caster_radius}" x_pos="0.120"/>
<xacro:caster_wheel caster_link="back" radius="${caster_radius}" x_pos="-0.120"/>

<!--___________________________Including standoff rods_______________________-->
<xacro:standoff_rod standoff_pos="right_positive" radius="${standoff_radius}" length="${standoff_length}" x_pos="0.090" y_pos="0.080"/>
<xacro:standoff_rod standoff_pos="right_negative" radius="${standoff_radius}" length="${standoff_length}" x_pos="0.090" y_pos="-0.080"/>
<xacro:standoff_rod standoff_pos="left_positive" radius="${standoff_radius}" length="${standoff_length}" x_pos="-0.090" y_pos="0.080"/>
<xacro:standoff_rod standoff_pos="left_negative" radius="${standoff_radius}" length="${standoff_length}" x_pos="-0.090" y_pos="-0.080"/>

<!--___________________________Including the cup tray (based_head)___________-->
<xacro:cup_holder_tray radius="${cup_tray_radius}" length="${cup_tray_length}"/>

<!--___________________________Including Laser with conditional_________________________-->
<xacro:if value="$(arg include_laser)">
    <xacro:Laser_scanner/>
</xacro:if>

<xacro:if value="$(arg include_laser)">
    <!-- ros2_control config -->
    <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
    <!-- Gazebo Sim integration plugin -->
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="laser_scan_link_joint">
    <command_interface name="position">
    <param name="min">-0.05</param>
    <param name="max">0.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
    </joint>

    <joint name="laser_scan_model_link_joint">
    <command_interface name="velocity">
    <param name="min">0.0</param>
    <param name="max">2.0</param>
    </command_interface>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <state_interface name="effort"/>
    </joint>
    </ros2_control>

    <!-- Gazebo Sim system plugin that boots the controller manager and parses the ros2_control tags -->
    <gazebo>
    <plugin filename="gz_ros2_control-system"
    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <!-- Controller configuration YAML file -->
    <parameters>$(find barista_robot_description)/config/controller_position_velocity.yaml</parameters>
    </plugin>
    </gazebo>
</xacro:if>

<!-- ______________________________PLUGINS for the robot, velocity, laser, etc-->
<!--Joint State Publisher Plugin-->
<!-- get the current joint angles-->
<gazebo>
<plugin filename="gz-sim-joint-state-publisher-system"
name="gz::sim::systems::JointStatePublisher">
<topic>/joint_states</topic>
<update_rate>30</update_rate>
<!-- Publish the state of these joints -->
<joint_name>joint_wheel_left</joint_name>
<joint_name>joint_wheel_right</joint_name>
<joint_name>front_yaw_joint</joint_name>
<joint_name>back_yaw_joint</joint_name>
<joint_name>front_roll_joint</joint_name>
<joint_name>back_roll_joint</joint_name>
<joint_name>front_pitch_joint</joint_name>
<joint_name>back_pitch_joint</joint_name>
<xacro:if value="$(arg include_laser)">
    <joint_name>laser_scan_link_joint</joint_name>
    <joint_name>laser_scan_model_link_joint</joint_name>
</xacro:if>
</plugin>
</gazebo>  

<!-- Differential Drive Plugin -->
<!-- move the links and the joints accordingly-->
<gazebo>
<plugin
filename="gz-sim-diff-drive-system"
name="gz::sim::systems::DiffDrive">
<left_joint>joint_wheel_left</left_joint>
<right_joint>joint_wheel_right</right_joint>
<wheel_separation>0.3</wheel_separation>
<wheel_radius>0.0352</wheel_radius>
<topic>/cmd_vel</topic>
<publish_odom>true</publish_odom>
<publish_odom_tf>true</publish_odom_tf>
<publish_wheel_tf>true</publish_wheel_tf>
<odom_topic>/odom</odom_topic>
<tf_topic>/tf</tf_topic>
<frame_id>odom</frame_id>
<child_frame_id>base_link</child_frame_id>
</plugin>
</gazebo>


<!-- ___________________________________________________ Enable Sensors in Gazebo Sim -->
<gazebo>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
<!-- use ogre2 if ogre v2.x is installed, otherwise use ogre -->
<render_engine>ogre2</render_engine>
</plugin>
</gazebo>   

</robot>