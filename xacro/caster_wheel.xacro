<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 
<xacro:macro name="caster_wheel" params="caster_link radius x_pos">

<link name="${caster_link}_yaw_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="6.58e-08" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="1.25e-07"/>
</inertial>
</link>

<joint name="${caster_link}_yaw_joint" type="continuous">
<origin rpy="0 0 0" xyz="${x_pos} 0 -0.0753"/>
<parent link="base_body"/>
<child link="${caster_link}_yaw_link"/>
<axis xyz="0 0 1"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<link name="${caster_link}_roll_link">
<visual>
<origin rpy="0 1.5707 0" xyz="0 0 0"/>
<geometry>
<cylinder length ="0.002" radius="0.005"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 1.5707 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.25e-07" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="6.58e-08"/>
</inertial>
</link>

<joint name="${caster_link}_roll_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0"/>
<parent link="${caster_link}_yaw_link"/>
<child link="${caster_link}_roll_link"/>
<axis xyz="1 0 0"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<link name="${caster_link}_pitch_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<sphere radius="${radius}"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<sphere radius="${radius}"/>
</geometry>
</collision>
<inertial>
<mass value="0.05"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.171e-05" ixy="0.0" ixz="0.0" 
iyy="1.171e-05" iyz="0.0" 
izz="1.171e-05"/>
</inertial>
</link>

<gazebo reference="${caster_link}_pitch_link">
<collision>
<surface>
<friction>
<ode>
<mu>0.001</mu>
<mu2>0.001</mu2>
</ode>
</friction>
<contact>
<ode>
<kp>10000000.0</kp>
<kd>10000000.0</kd>
</ode>
</contact>
</surface>
</collision>
</gazebo>

<joint name="${caster_link}_pitch_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0" />
<parent link="${caster_link}_roll_link" />
<child link="${caster_link}_pitch_link" />
<axis xyz="0 1 0" />
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

</xacro:macro>
</robot>