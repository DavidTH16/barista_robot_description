<link name="back_roll_link">
<visual>
<origin rpy="0 1.5707 0" xyz="0 0 0"/>
<geometry>
<cylinder length ="0.002" radius="0.005"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 1.5707 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.25e-07" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="6.58e-08"/>
</inertial>
</link>

<joint name="back_roll_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0"/>
<parent link="back_yaw_link"/>
<child link="back_roll_link"/>
<axis xyz="1 0 0"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<link name="back_pitch_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
</collision>
<inertial>
<mass value="0.05"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.171e-05" ixy="0.0" ixz="0.0" 
iyy="1.171e-05" iyz="0.0" 
izz="1.171e-05"/>
</inertial>
</link>


<gazebo reference="back_pitch_link">
<collision>
<surface>
<friction>
<ode>
<mu>0.001</mu>
<mu2>0.001</mu2>
</ode>
</friction>
<contact>
<ode>
<kp>10000000.0</kp>
<kd>10000000.0</kd>
</ode>
</contact>
</surface>
</collision>
</gazebo>

<joint name="back_pitch_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0" />
<parent link="back_roll_link" />
<child link="back_pitch_link" />
<axis xyz="0 1 0" />
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<!-- ___________________________Standoff rods______________________________________-->
<!--Right positive-->
<link name="base_standoff_right_positive">
<visual>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
</collision>
<inertial>
<mass value="0.18"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="7.305e-04" ixy="0.0" ixz="0.0" 
iyy="7.305e-04" iyz="0.0" 
izz="9.0e-06"/>
</inertial>
</link>

<joint name="joint_standoff_right_positive" type="fixed">
<origin rpy="0 0 0" xyz="0.090 0.080 0.1875"/>
<parent link="base_body"/>
<child link="base_standoff_right_positive"/>
</joint>

