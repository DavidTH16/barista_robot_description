<?xml version="1.0"?>
<robot name="barista_robot">

<!-- ____________________________ Materials defined for this robot____________-->
<material name="blue">
<color rgba="0.0 0.0 1.0 1"/>
</material>

<material name="gray">
<color rgba="0.5 0.5 0.5 1"/>
</material> 

<material name="rubber_black">
<color rgba="0.05 0.05 0.05 1"/>
</material>

<!-- ____________________________ Link base______________________________________ -->
<link name="base_link">
</link>


<link name="base_body">
<visual>
<geometry>
<cylinder length="0.155" radius="0.178"/>
</geometry>
<material name="blue"/>
</visual>
</link>

<joint name="base_link_joint" type="fixed">
<origin rpy="0 0 0" xyz="0 0 0.0995"/>
<parent link="base_link"/>
<child link="base_body"/>
</joint>

<!--____________________________WHeels robot_______________________________________-->
<!--Right Wheel-->
<link name="base_wheel_right">
<visual>
<origin rpy="1.5707 0 0" xyz="0 0 0"/>
<geometry>
<!-- cylinders aligned along axis Z, rotate around x (90/pi)-->
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
<material name="rubber_black"/>
</visual>
</link>

<joint name="joint_wheel_right" type="continuous">
<origin rpy="0 0 0" xyz="0.0 -0.150 -0.0643"/>
<parent link="base_body"/>
<child link="base_wheel_right"/>
<axis xyz="0 1 0"/>
</joint>

<!--Left Wheel-->
<link name="base_wheel_left">
<visual>
<origin rpy="1.5707 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
<material name="rubber_black"/>
</visual>
</link>

<joint name="joint_wheel_left" type="continuous">
<origin rpy="0 0 0" xyz="0.0 0.150 -0.0643"/>
<parent link="base_body"/>
<child link="base_wheel_left"/>
<axis xyz="0 1 0"/>
</joint>

<!-- _________________________ Caster Wheels __________________________ -->
<!--Caster front-->
<link name="front_yaw_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.002" radious="0.005"/>
</geometry>
<material name="blue"/>
</visual>
</link>

<joint name="front_yaw_joint" type="continuous">
<origin rpy="0 0 0" xyz="0.120 0 -0.0753"/>
<parent link="base_body"/>
<child link="front_yaw_link"/>
<axis xyz="0 0 1"/>
</joint>

<link name="front_roll_link">
<visual>
<origin rpy="0 1.5707 0" xyz="0 0 0"/>
<geometry>
<cylinder length ="0.002" radius="0.005"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="front_roll_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0"/>
<parent link="front_yaw_link"/>
<child link="front_roll_link"/>
<axis xyz="1 0 0"/>
</joint>

<link name="front_pitch_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="front_pitch_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0" />
<parent link="front_roll_link" />
<child link="front_pitch_link" />
<axis xyz="0 1 0" />
</joint>

<!-- Caster Wheel back -->
<link name="back_yaw_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.002" radious="0.005"/>
</geometry>
<material name="blue"/>
</visual>
</link>

<joint name="back_yaw_joint" type="continuous">
<origin rpy="0 0 0" xyz="-0.120 0 -0.0753"/>
<parent link="base_body"/>
<child link="back_yaw_link"/>
<axis xyz="0 0 1"/>
</joint>

<link name="back_roll_link">
<visual>
<origin rpy="0 1.5707 0" xyz="0 0 0"/>
<geometry>
<cylinder length ="0.002" radius="0.005"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="back_roll_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0"/>
<parent link="back_yaw_link"/>
<child link="back_roll_link"/>
<axis xyz="1 0 0"/>
</joint>

<link name="back_pitch_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="back_pitch_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0" />
<parent link="back_roll_link" />
<child link="back_pitch_link" />
<axis xyz="0 1 0" />
</joint>

<!-- ___________________________Standoff rods______________________________________-->
<!--Right positive-->
<link name="base_standoff_right_positive">
<visual>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="joint_standoff_right_positive" type="fixed">
<origin rpy="0 0 0" xyz="0.090 0.080 0.1875"/>
<parent link="base_body"/>
<child link="base_standoff_right_positive"/>
</joint>

<!--Right negative-->
<link name="base_standoff_right_negative">
<visual>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="joint_standoff_right_negative" type="fixed">
<origin rpy="0 0 0" xyz="0.090 -0.080 0.1875"/>
<parent link="base_body"/>
<child link="base_standoff_right_negative"/>
</joint>

<!--Left positive-->
<link name="base_standoff_left_positive">
<visual>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="joint_standoff_left_positive" type="fixed">
<origin rpy="0 0 0" xyz="-0.090 0.080 0.1875"/>
<parent link="base_body"/>
<child link="base_standoff_left_positive"/>
</joint>

<!--Left negative-->
<link name="base_standoff_left_negative">
<visual>
<geometry>
<cylinder length="0.220" radius="0.010"/>
</geometry>
<material name="gray"/>
</visual>
</link>

<joint name="joint_standoff_left_negative" type="fixed">
<origin rpy="0 0 0" xyz="-0.090 -0.080 0.1875"/>
<parent link="base_body"/>
<child link="base_standoff_left_negative"/>
</joint>

<!--_________________________________Base Head________________________________-->
<link name="base_head">
<visual>
<geometry>
<cylinder length="0.090" radius="0.160"/>
</geometry>
<material name="blue"/>
</visual>
</link>

<joint name="joint_head_right_positive" type="fixed">
<origin rpy="0 0 0" xyz="0 0 0.3425"/>
<child link="base_head"/>
<parent link="base_body"/>
</joint>


</robot>