<?xml version="1.0"?>
<robot name="barista_robot">

<!-- ____________________________ Materials defined for this robot____________-->
<material name="blue">
<color rgba="0.0 0.0 1.0 1"/>
</material>

<material name="gray">
<color rgba="0.5 0.5 0.5 1"/>
</material> 

<material name="rubber_black">
<color rgba="0.05 0.05 0.05 1"/>
</material>

<!-- ____________________________ Base link______________________________________ -->
<link name="base_link">
</link>


<link name="base_body">
<visual>
<geometry>
<cylinder length="0.155" radius="0.178"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.155" radius="0.178"/>
</geometry>
</collision>

<!-- mass 7kg-->
<inertial>
<mass value ="7.0"/>
<origin rpy="0 0 0" xyz="0 0 0"/>
<inertia ixx="0.06946" ixy="0.0" ixz="0.0" iyy="0.06946" iyz="0.0" izz="0.11089"/>
</inertial>
</link>



<joint name="base_link_joint" type="fixed">
<origin rpy="0 0 0" xyz="0 0 0.0995"/>
<parent link="base_link"/>
<child link="base_body"/>
</joint>

<!--____________________________Wheels robot_______________________________________-->
<!--Right Wheel-->
<link name="base_wheel_right">
<visual>
<origin rpy="1.5707 0 0" xyz="0 0 0"/>
<geometry>
<!-- cylinders aligned along axis Z, rotate around x (90/pi)-->
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
<material name="rubber_black"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="1.5707 0 0"/>
<geometry>
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
</collision>
<!-- mass = 0.5kg-->
<inertial>
<mass value="0.5"/>
<origin xyz="0 0 0" rpy="1.5707 0 0"/>
<inertia ixx="0.000173" ixy="0.0" ixz="0.0" iyy="0.000310" iyz="0.0" izz="0.000173"/>
</inertial>
</link>

<gazebo reference="base_wheel_right">
<collision>
<surface>
<friction>
<ode>
<mu>1.0</mu>
<mu2>1.0</mu2>
</ode>
</friction>
<contact>
<ode>
<kp>10000000.0</kp>
<kd>10000000.0</kd>
</ode>
</contact>
</surface>
</collision>
</gazebo>

<joint name="joint_wheel_right" type="continuous">
<origin rpy="0 0 0" xyz="0.0 -0.150 -0.0643"/>
<parent link="base_body"/>
<child link="base_wheel_right"/>
<axis xyz="0 1 0"/>
<limit effort="10000" velocity="1000"/>
<joint_properties damping="1.0" friction="1.0"/>
</joint>

<!--Left Wheel__________________-->
<link name="base_wheel_left">
<visual>
<origin rpy="1.5707 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
<material name="rubber_black"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="1.5707 0 0"/>
<geometry>
<cylinder length="0.0206" radius="0.0352"/>
</geometry>
</collision>
<!-- mass = 0.5kg-->
<inertial>
<mass value="0.5"/>
<origin xyz="0 0 0" rpy="1.5707 0 0"/>
<inertia ixx="0.000173" ixy="0.0" ixz="0.0" iyy="0.000310" iyz="0.0" izz="0.000173"/>
</inertial>
</link>

<gazebo reference="base_wheel_left">
<collision>
<surface>
<friction>
<ode>
<mu>1.0</mu>
<mu2>1.0</mu2>
</ode>
</friction>
<contact>
<ode>
<kp>10000000.0</kp>
<kd>10000000.0</kd>
</ode>
</contact>
</surface>
</collision>
</gazebo>

<joint name="joint_wheel_left" type="continuous">
<origin rpy="0 0 0" xyz="0.0 0.150 -0.0643"/>
<parent link="base_body"/>
<child link="base_wheel_left"/>
<axis xyz="0 1 0"/>
<limit effort="10000" velocity="1000"/>
<joint_properties damping="1.0" friction="1.0"/>
</joint>

<!-- _________________________ Caster Wheels __________________________ -->
<!--Caster front-->
<link name="front_yaw_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="6.58e-08" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="1.25e-07"/>
</inertial>
</link>

<joint name="front_yaw_joint" type="continuous">
<origin rpy="0 0 0" xyz="0.120 0 -0.0753"/>
<parent link="base_body"/>
<child link="front_yaw_link"/>
<axis xyz="0 0 1"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<link name="front_roll_link">
<visual>
<origin rpy="0 1.5707 0" xyz="0 0 0"/>
<geometry>
<cylinder length ="0.002" radius="0.005"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 1.5707 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.25e-07" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="6.58e-08"/>
</inertial>
</link>

<joint name="front_roll_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0"/>
<parent link="front_yaw_link"/>
<child link="front_roll_link"/>
<axis xyz="1 0 0"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<link name="front_pitch_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
<material name="gray"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<sphere radius="0.0242"/>
</geometry>
</collision>
<inertial>
<mass value="0.05"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="1.171e-05" ixy="0.0" ixz="0.0" 
iyy="1.171e-05" iyz="0.0" 
izz="1.171e-05"/>
</inertial>
</link>

<gazebo reference="front_pitch_link">
<collision>
<surface>
<friction>
<ode>
<mu>0.001</mu>
<mu2>0.001</mu2>
</ode>
</friction>
<contact>
<ode>
<kp>10000000.0</kp>
<kd>10000000.0</kd>
</ode>
</contact>
</surface>
</collision>
</gazebo>

<joint name="front_pitch_joint" type="continuous">
<origin rpy="0 0 0" xyz="0 0 0" />
<parent link="front_roll_link" />
<child link="front_pitch_link" />
<axis xyz="0 1 0" />
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
</joint>

<!-- Caster Wheel back -->
<link name="back_yaw_link">
<visual>
<origin rpy="0 0 0" xyz="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
<material name="blue"/>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<cylinder length="0.002" radius="0.005"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia 
ixx="6.58e-08" ixy="0.0" ixz="0.0" 
iyy="6.58e-08" iyz="0.0" 
izz="1.25e-07"/>
</inertial>
</link>

<joint name="back_yaw_joint" type="continuous">
<origin rpy="0 0 0" xyz="-0.120 0 -0.0753"/>
<parent link="base_body"/>
<child link="back_yaw_link"/>
<axis xyz="0 0 1"/>
<limit effort="1000.0" velocity="100.0" />
<dynamics damping="0.0" friction="0.1"/>
